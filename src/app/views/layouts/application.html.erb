    document.addEventListener('DOMContentLoaded', function () {

    /* Small screens: any table wider than its container gets wrapped in a horizontally
       scrolling box, so it never widens the whole page. Re-run when AJAX content arrives. */
    var mqSmall = window.matchMedia('(max-width: 767.98px)');
    function fitWideTables() {
      if (!mqSmall.matches) return;
      document.querySelectorAll('table').forEach(function (t) {
        var p = t.parentElement;
        if (!p || t.closest('.dataTables_wrapper, .table-scroll')) return;
        if (t.offsetWidth > p.clientWidth + 1) {
          var w = document.createElement('div');
          w.className = 'table-scroll';
          p.insertBefore(w, t);
          w.appendChild(t);
        }
      });
    }
    if (mqSmall.matches) {
      fitWideTables();
      var fitTimer;
      new MutationObserver(function () { clearTimeout(fitTimer); fitTimer = setTimeout(fitWideTables, 250); })
        .observe(document.body, {childList: true, subtree: true});
    }

    $("#ontop_popup_window3").draggable()
    
