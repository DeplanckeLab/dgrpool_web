    <script src="https://cdn.plot.ly/plotly-2.16.1.min.js"></script>
    <script>
      /* Small screens: plots are created with fixed desktop widths (400-800px).
         On phones, shrink any plot wider than its container to fit (square plots keep
         their aspect ratio). Desktop rendering is untouched. The ordered per-line plots
         are deliberately wide and scroll horizontally inside their card, so skip them. */
      (function () {
        if (!window.Plotly) return;
        var newPlot = Plotly.newPlot;
        var mq = window.matchMedia('(max-width: 767.98px)');
        Plotly.newPlot = function (gd, data, layout, config) {
          try {
            var el = (typeof gd === 'string') ? document.getElementById(gd) : gd;
            if (mq.matches && el && layout && !/^ordered_/.test(el.id || '')) {
              var avail = el.clientWidth || el.parentElement && el.parentElement.clientWidth || 0;
              avail = Math.min(avail || 9999, document.documentElement.clientWidth - 24);
              if (!layout.width || layout.width > avail) {
                if (layout.width && layout.height && layout.width === layout.height) layout.height = avail;
                layout.width = avail;
              }
            }
          } catch (e) {}
          return newPlot.apply(this, arguments);
        };
      })();
    </script>

