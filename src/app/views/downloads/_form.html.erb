<%= form_with(model: download) do |form| %>
  <% if download.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(download.errors.count, "error") %> prohibited this download from being saved:</h2>

      <ul>
        <% download.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group row">
    <%= label_tag "Filename", nil, {:class => 'col-sm-2 col-form-label'} %>
    <div class="col-sm-10">
      <%= form.text_field :filename, {:class => 'form-control', :placeholder => 'dgrp_lines.tsv'} %>
    </div>
  </div>

  <div class="form-group row">
    <%= label_tag "Description", nil, {:class => 'col-sm-2 col-form-label'} %>
    <div class="col-sm-10">
      <%= form.text_area :description, {:rows => 4, :class => 'form-control'} %>
    </div>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
