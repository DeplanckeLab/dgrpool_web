<%# Rows are loaded page by page from table_data (DataTables server-side processing): searching, sorting and
    paging are done in SQL by PhenotypesController#table_data. %>
<table id='phenotypes' class='table-striped' width='100%'>
  <thead>
    <tr>
      <% if curator? %>
      <th>ID</th>
      <% end %>
      <th>Name</th>
      <th>Study</th>
      <th>Description</th>
      <th>Source type</th>
      <th>Value type</th>
      <th># DGRP lines</th>
      <th># female</th>
      <th># male</th>
      <th># unclassified sex</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
  </tbody>
</table>

<% columns = (curator? ? ['id'] : []) + %w[name study description source_type value_type nber_dgrp_lines nber_sex_female nber_sex_male nber_sex_na] %>
<%= javascript_tag do %>

  document.addEventListener('DOMContentLoaded', function () {
    $("#phenotypes").DataTable({
      serverSide: true,
      processing: true,
      searchDelay: 400,
      pageLength: 100,
      ajax: {
        url: '<%= raw table_data_phenotypes_path(:only_curated_studies => params[:only_curated_studies], :no_obsolete => params[:no_obsolete], :all => params[:all]) %>'
      },
      columns: <%= raw (columns.map { |c| {:data => c} } + [{:data => 'actions', :orderable => false, :searchable => false}]).to_json %>,
      drawCallback: function () { initTooltips() }
    })

    $("#only_integrated_studies").click(function(){
      if ($(this).prop("checked") == true){
        location.href='<%= raw phenotypes_path(:only_curated_studies=>1) %>'
      }else{
        location.href='<%= raw phenotypes_path(:only_curated_studies=>0) %>'
      }
    })
  });

<% end %>
